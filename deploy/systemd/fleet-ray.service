[Unit]
Description=zkm-fleet Ray node (head or worker, from /etc/zkm-fleet/ray.env)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=fleet
Type=forking
EnvironmentFile=/etc/zkm-fleet/ray.env
# RAY_ROLE=head | worker, RAY_HEAD=<head ip>, CUDA_VISIBLE_DEVICES=<cards Ray may hand out>
ExecStart=/opt/zkm-fleet/deploy/ray-start.sh ${RAY_ROLE} ${RAY_HEAD}
ExecStop=/opt/zkm-fleet/venv/bin/ray stop --force
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
