[Unit]
Description=zkm-fleet Ray bridge (keeps the prover actors running)
After=fleet-ray.service fleet-scheduler.service
Requires=fleet-ray.service

[Service]
User=fleet
WorkingDirectory=/opt/zkm-fleet/bridge
ExecStart=/opt/zkm-fleet/venv/bin/python -m fleet_bridge run --services /etc/zkm-fleet/services.yaml --address 127.0.0.1:6379
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
