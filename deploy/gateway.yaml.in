# HTTPS ingress; internal scheduler and MCP listeners are not public.
static_resources:
  listeners:
  - name: https
    address:
      socket_address:
        address: 0.0.0.0
        port_value: 8905
    filter_chains:
    - filters:
      - name: envoy.filters.network.http_connection_manager
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
          stat_prefix: fleet
          codec_type: AUTO
          stream_idle_timeout: 0s
          route_config:
            virtual_hosts:
            - name: fleet
              domains:
              - '*'
              routes:
              # Only node appraisal is public. Policy administration never leaves
              # the private AS listener, including unknown/future RPC methods.
              - match:
                  path: /attestation.AttestationService/AttestationEvaluate
                route:
                  cluster: trustee
                  timeout: 30s
                typed_per_filter_config:
                  envoy.filters.http.rbac:
                    '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                    rbac:
                      rules:
                        action: ALLOW
                        policies:
                          trustee-node:
                            permissions: [{ any: true }]
                            principals:
                            - custom:
                                name: envoy.rbac.principals.mtls_authenticated
                                typed_config:
                                  '@type': type.googleapis.com/envoy.extensions.rbac.principals.mtls_authenticated.v3.Config
                                  san_matcher:
                                    san_type: URI
                                    matcher:
                                      safe_regex:
                                        regex: 'spiffe://fleet/trustee/node/[a-zA-Z0-9_-]+'
              - match:
                  prefix: /attestation.
                direct_response: { status: 403 }
              - match:
                  prefix: /mcp
                route:
                  cluster: mcp
                  timeout: 0s
              - match:
                  prefix: /fleet.v1.WorkerService/
                route:
                  cluster: control
                  timeout: 0s
              - match:
                  prefix: /fleet.v1.ControlService/
                route:
                  cluster: control
                  timeout: 0s
              - match:
                  prefix: /trusted.ledger.v1.AuthorizationLedger/
                route:
                  cluster: policy
                  timeout: 0s
              - match:
                  prefix: /
                route:
                  cluster: http
                  timeout: 0s
          http_filters:
          - name: envoy.filters.http.rbac
            typed_config:
              '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
          - name: envoy.filters.http.router
            typed_config:
              '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
      transport_socket:
        name: envoy.transport_sockets.tls
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
          common_tls_context:
            # Existing Fleet clients may omit a certificate. The Trustee route's
            # mTLS principal independently requires a validated node certificate.
            validation_context:
              trusted_ca:
                filename: /etc/zkm-fleet/tls/ca.pem
            alpn_protocols:
            - h2
            - http/1.1
            tls_certificates:
            - certificate_chain:
                filename: /etc/zkm-fleet/tls/server.pem
              private_key:
                filename: /etc/zkm-fleet/tls/server.key
  clusters:
  - name: trustee
    type: STRICT_DNS
    connect_timeout: 2s
    load_assignment:
      cluster_name: trustee
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address:
                address: trustee-as
                port_value: 50004
    typed_extension_protocol_options:
      envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
        '@type': type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
        explicit_http_config:
          http2_protocol_options: {}
  - name: control
    type: STATIC
    connect_timeout: 2s
    load_assignment:
      cluster_name: control
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address:
                address: '@SCHEDULER_IP@'
                port_value: 51001
    typed_extension_protocol_options:
      envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
        '@type': type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
        explicit_http_config:
          http2_protocol_options: {}
    transport_socket:
      name: envoy.transport_sockets.tls
      typed_config:
        '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
        sni: stage
        common_tls_context:
          alpn_protocols:
          - h2
          validation_context:
            trusted_ca:
              filename: /etc/zkm-fleet/tls/ca.pem
            match_typed_subject_alt_names:
            - san_type: DNS
              matcher:
                exact: stage
  - name: http
    type: STATIC
    connect_timeout: 2s
    load_assignment:
      cluster_name: http
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address:
                address: '@SCHEDULER_IP@'
                port_value: 9191
  # The ledger shares the scheduler HTTP listener, but gRPC needs an HTTP/2
  # upstream. Do not retry single-use grant consumption after an ambiguous RPC.
  - name: policy
    type: STATIC
    connect_timeout: 2s
    load_assignment:
      cluster_name: policy
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address:
                address: '@SCHEDULER_IP@'
                port_value: 9191
    typed_extension_protocol_options:
      envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
        '@type': type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
        explicit_http_config:
          http2_protocol_options: {}
  - name: mcp
    type: STRICT_DNS
    connect_timeout: 2s
    load_assignment:
      cluster_name: mcp
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address:
                address: mcp
                port_value: 8906
