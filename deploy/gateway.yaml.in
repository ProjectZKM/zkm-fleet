# HTTPS ingress; internal scheduler and MCP listeners are not public.
static_resources:
  listeners:
  - name: https
    address:
      socket_address:
        address: 0.0.0.0
        port_value: 8905
    filter_chains:
    - filters:
      - name: envoy.filters.network.http_connection_manager
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
          stat_prefix: fleet
          codec_type: AUTO
          stream_idle_timeout: 0s
          route_config:
            virtual_hosts:
            - name: fleet
              domains:
              - '*'
              routes:
              - match:
                  prefix: /mcp
                route:
                  cluster: mcp
                  timeout: 0s
              - match:
                  prefix: /fleet.v1.WorkerService/
                route:
                  cluster: control
                  timeout: 0s
              - match:
                  prefix: /fleet.v1.ControlService/
                route:
                  cluster: control
                  timeout: 0s
              - match:
                  prefix: /stage.v1.StageService/
                per_request_buffer_limit_bytes: 268435456
                route:
                  cluster: stage
                  timeout: 0s
                  retry_policy:
                    retry_on: connect-failure,refused-stream,reset,unavailable
                    num_retries: 120
                    per_try_timeout: 600s
                    retry_back_off:
                      base_interval: 0.25s
                      max_interval: 1s
              - match:
                  prefix: /
                route:
                  cluster: http
                  timeout: 0s
          http_filters:
          - name: envoy.filters.http.router
            typed_config:
              '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
      transport_socket:
        name: envoy.transport_sockets.tls
        typed_config:
          '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
          common_tls_context:
            alpn_protocols:
            - h2
            - http/1.1
            tls_certificates:
            - certificate_chain:
                filename: /etc/zkm-fleet/tls/server.pem
              private_key:
                filename: /etc/zkm-fleet/tls/server.key
  clusters:
  - name: stage
    type: STATIC
    connect_timeout: 2s
    load_assignment:
      cluster_name: stage
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address:
                address: '@SCHEDULER_IP@'
                port_value: 51000
    typed_extension_protocol_options:
      envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
        '@type': type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
        explicit_http_config:
          http2_protocol_options: {}
  - name: control
    type: STATIC
    connect_timeout: 2s
    load_assignment:
      cluster_name: control
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address:
                address: '@SCHEDULER_IP@'
                port_value: 51001
    typed_extension_protocol_options:
      envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
        '@type': type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
        explicit_http_config:
          http2_protocol_options: {}
    transport_socket:
      name: envoy.transport_sockets.tls
      typed_config:
        '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
        sni: stage
        common_tls_context:
          alpn_protocols:
          - h2
          validation_context:
            trusted_ca:
              filename: /etc/zkm-fleet/tls/ca.pem
            match_typed_subject_alt_names:
            - san_type: DNS
              matcher:
                exact: stage
  - name: http
    type: STATIC
    connect_timeout: 2s
    load_assignment:
      cluster_name: http
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address:
                address: '@SCHEDULER_IP@'
                port_value: 9191
  - name: mcp
    type: STRICT_DNS
    connect_timeout: 2s
    load_assignment:
      cluster_name: mcp
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address:
                address: mcp
                port_value: 8906
