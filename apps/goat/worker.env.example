# Install as `.env` in the worker's working directory (`run/` in the storage root),
# readable only by the account in the entry's `user`.
DATABASE_URL=sqlite:/srv/zkm-fleet/apps/goat/run/proof-builder.db
# Must match the package's programs.json (imm_wrap_vk).
ZKM_IMM_WRAP_VK=1
# Read-only GOAT connection for live Operator/Watchtower authorization.
GOAT_NETWORK=main
GOAT_CHAIN_URL=https://YOUR_GOAT_RPC
# One or more comma-separated Gateway addresses on that network.
GOAT_GATEWAY_CONTRACT_ADDRESS=0xREPLACE
# The entry supplies the app identity, the storage root and the programs file, the
# entrypoint the GPU endpoint.
# Do not set ZKM_PROVER, ENDPOINT, FLEET_TOKEN_FILE or FLEET_EXIT_WITH_PARENT: the worker
# does not use the SDK network prover, and it runs in a container.
