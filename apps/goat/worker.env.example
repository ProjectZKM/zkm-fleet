# Install as a private file readable only by the Fleet execution user.
DATABASE_URL=sqlite:/srv/zkm-fleet/apps/goat/run/proof-builder.db
PROOF_BUILDER_PROGRAMS_FILE=/opt/zkm-fleet/apps/goat/programs.json
# Must match the package's programs.json (imm_wrap_vk).
ZKM_IMM_WRAP_VK=1
# Required by the pinned worker, which only uses it to label its log. Fleet now injects
# FLEET_APP instead, so set it here until the worker reads FLEET_APP.
FLEET_APP_TENANT=goat
# Read-only GOAT connection for live Operator/Watchtower authorization.
GOAT_NETWORK=main
GOAT_CHAIN_URL=https://YOUR_GOAT_RPC
# One or more comma-separated Gateway addresses on that network.
GOAT_GATEWAY_CONTRACT_ADDRESS=0xREPLACE
# Fleet supplies the GPU endpoint, storage root, app name, namespace, elf_id and
# parent-exit behavior; it overrides those variables if they are set here.
# Do not set ZKM_PROVER, ENDPOINT or FLEET_TOKEN_FILE: the worker does not use the SDK
# network prover.
# Values containing spaces must be quoted. Shell expansion is not performed.
