# Install as a private file readable only by the Fleet execution user.
HTTP_RPC_URL=https://YOUR_ETHEREUM_MAINNET_RPC
DEBUG_HTTP_RPC_URL=https://YOUR_ETHEREUM_MAINNET_DEBUG_RPC
ETH_PROOFS_ENDPOINT=https://YOUR_ETHPROOFS_API
ETH_PROOFS_API_TOKEN=REPLACE
ETH_PROOFS_ELF_FILE=/opt/zkm-fleet/apps/ethproofs/program.elf
# Fleet supplies GPU endpoint, state root, app identity and parent-exit behavior.
# Values containing spaces must be quoted. Shell expansion is not performed.
